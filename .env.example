# Supabase — local: values printed by `npx supabase start`; cloud: project settings > API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Claude API. Leave empty to run the AI layer in clearly-labelled demo mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# 32-byte base64 key used to encrypt integration credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=
# Bearer token for /api/jobs/tick (cron).
CRON_SECRET=

# Shows demo accounts on the login page and enables demo simulations.
NEXT_PUBLIC_DEMO_MODE=true
# Runs the job tick every minute inside the dev server (local only).
ENABLE_DEV_SCHEDULER=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Model that judges incoming Slack messages and tips (cheap, fast). The main model (ANTHROPIC_MODEL) interviews, writes and checks.
ANTHROPIC_TRIAGE_MODEL=claude-haiku-5-5
# Sign in with Slack (also enable [auth.external.slack_oidc] in supabase/config.toml or the Supabase dashboard).
NEXT_PUBLIC_SLACK_LOGIN=false
# Sign in with Google, restricted to @nobears.nl. Also set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in supabase/.env (local) or the Supabase dashboard (cloud).
NEXT_PUBLIC_GOOGLE_LOGIN=false
# Bearer token for the mailbox webhook POST /api/inbound/mail.
INBOUND_MAIL_SECRET=
